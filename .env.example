# Copy to .env and fill in. docker compose reads .env automatically.

# Required: password for the web UI
ADMIN_PASSWORD=change-me

# Recommended: random string so logins survive restarts
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Host port to expose the app on
PORT=3000

# How often to re-check all wishlists (minutes, minimum 5)
CHECK_INTERVAL_MINUTES=30

# Set to true when serving over HTTPS (e.g. behind a reverse proxy)
COOKIE_SECURE=false

# Set to 1 when behind a reverse proxy so login rate-limiting sees real client IPs
TRUST_PROXY=
